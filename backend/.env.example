# Copy to .env and adjust. All values are optional.

# SQLite (default, zero setup):
# DATABASE_URL=sqlite:///./data/cti.db

# PostgreSQL (the project's target database):
# DATABASE_URL=postgresql+psycopg://cti:cti@localhost:5432/cti

# Load the bundled demo data (sources, indicators, CVEs, pipeline history) on
# first start when the database is empty. Set to false for a clean live corpus.
CTI_SEED_ON_STARTUP=true

# Comma separated origins allowed to call the API from a browser.
CTI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Live collection -------------------------------------------------------
# auto    = live connectors when available, bundled fixtures as fallback (default)
# live    = live only; an unreachable feed is recorded as a failed pipeline run
# fixture = never touch the network
CTI_FEED_MODE=auto

# Seconds per HTTP request, and how many extra attempts a failed request gets.
CTI_HTTP_TIMEOUT=25
CTI_HTTP_RETRIES=2

# Upper bound of raw records pulled from one source per collection cycle.
CTI_MAX_RECORDS_PER_SOURCE=60

# --- Credentials (only needed for the feeds that require them) -------------
# abuse.ch Auth-Key — mandatory since 2025 for URLhaus (the keyless download
# paths now return HTTP 410). Free account: https://auth.abuse.ch
# ABUSECH_AUTH_KEY=

# AlienVault OTX (free account): https://otx.alienvault.com/api
# OTX_API_KEY=

# NVD raises its rate limit from 5 to 50 requests / 30s with a key:
# https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=

# Generic TAXII 2.1 collection poller for STIX indicators (used by the
# "MITRE ATT&CK — TAXII 2.1" source):
# TAXII_URL=https://your-taxii-server.example/taxii2
# TAXII_COLLECTION=your-collection-id
# TAXII_TOKEN=

# --- Background collection -------------------------------------------------
# Minutes between automatic collection cycles. 0 disables the background loop.
CTI_COLLECT_INTERVAL_MINUTES=15

# Run a cycle immediately at startup instead of waiting one full interval.
CTI_COLLECT_ON_START=false
